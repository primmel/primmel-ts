// Conformance corpus: the coherent calculation-variant shape with ONE
// seeded violation — the expression-typed variant drops its expression
// facet. C125 must fire exactly once.
// Clause: COD-02 (negative).
// The display expression's names are declared as symbols so C149 stays
// silent — this case's only violation is the missing expression facet.
symbol E_L {
  name "Load cell error"
  definition "the load cell error at the reference load"
  type number
  unit "1"
}

symbol I {
  name "Indication"
  definition "the instrument indication at the load"
  type number
  unit "1"
}

symbol I_ref {
  name "Reference indication"
  definition "the reference indication for the error computation"
  type number
  unit "1"
}

calculation loadCellError {
  name "loadCellError"
  description "Load cell error"
  inputs {
    avgIndicationAt75pct : number { unit "1" description "Average indication" }
    referenceIndication : number { unit "1" description "Reference indication" }
  }
  output : number { unit "1" }
  expression "E_L = (I - I_ref) / f"
  variant engine {
    type expression
    label "Load Cell Error E_L"
    params { avgIndication referenceIndication conversion_factor_f }
  }
}
