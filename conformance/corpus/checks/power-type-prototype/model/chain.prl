attribute_definition p_lc {
  name "Apportioning factor"
  definition "The ratio p_LC = E_max / (n_LC · v_min)."
  value_type number
  origin design-fixed
  scope family
  category metrological
}

subject LoadCellModelFamily {
  has { attributes { p_lc } }
}

class ProductionUnit {
  serial_number : string { modality SHALL }
}

instance proto-500 {
  of LoadCellModelFamily
  level family
  definition_versions { LoadCellModelFamily : "2021" attributes : "1.0.0" }
  has { attributes { p_lc : 0.7 } }
}

class ProductLine {
  extends { proto-500 }
  serial_number : string { modality SHALL }
}

instance u7 {
  of ProductLine
  level model
  definition_versions { LoadCellModelFamily : "2021" attributes : "1.0.0" }
}
