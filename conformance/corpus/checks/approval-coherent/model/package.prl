// Conformance corpus: a coherent approval — actor and approve_by resolve to declared
// roles, the approval_record entry to a declared entity-class
// store. C143 stays silent.
// Clause: WF-03 (positive).

role applicant {
  name "Applicant"
}
role ia_checker {
  name "IA checker"
}
class Application#data {
  store { applications }
  id: string { modality SHALL }
}
approval ia_approve_application {
  name "IA approves the application"
  actor applicant
  modality shall
  approve_by ia_checker
  approval_record {
    applications
  }
  source { doc "PD-05 §4.2" clause "" }
}
