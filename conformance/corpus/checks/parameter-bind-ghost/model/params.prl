attribute_definition e_max {
  symbol "E_max"
  origin design-fixed
  scope model
}

# The parameter's bind path names an attribute that is not declared:
# C118 must fire.
requirement /req/capacity {
  name "Maximum capacity"
  statement "The instrument shall indicate up to its maximum capacity."
  parameters {
    param e_max: number { description "Maximum capacity." bind "model.parameters.ghost_attr" range { min 0 } }
  }
}
