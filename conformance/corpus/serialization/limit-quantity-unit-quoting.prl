requirement /req/sensitivity {
  label "Sensitivity"
  statement { The conversion factor from counts to verification units is positive. }
  limit {
    expression "ocl{self.f > 0}"
    uses { f }
    quantity { kind volume-fraction unit "counts/v" }
  }
}
