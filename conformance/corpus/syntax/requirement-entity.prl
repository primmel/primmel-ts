# Conformance corpus: the requirement entity in both spellings.
# Clauses: SYN-03 (positive), SER-01 (positive).
provision ProvMPE {
  condition "The error shall not exceed the maximum permissible error"
  modality SHALL
}

requirement /req/metrological/mpe {
  name "Maximum permissible error"
  statement "The absolute value of the error shall not exceed the MPE"
  modality SHALL
}
