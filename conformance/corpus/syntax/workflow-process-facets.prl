# Conformance corpus: the workflow-process facets — phase (the
# pipeline phase), the gate facet's anonymous entry-condition entries
# (the ordered guard criteria, folded — TODO.lang-spec/07) and its
# machine_service documentary engine-run entry, and the clause-URN
# provenance (free citation strings land in doc).
# Clause: WF-01 (positive).
data_registry testRequests {
  name "Test requests"
}
process conduct_tests {
  name "Conduct tests"
  modality shall
  phase testing
  gates {
    entry_condition { check "Each TestRequest references >= 1 MeasuringInstrumentSample" on_violation invalid }
    entry_condition { check "TestRequest.assigned_laboratory_id is accredited for the requested accuracy classes" on_violation invalid }
    machine_service { verdict_computation evaluation_aggregation certificate_characteristics_derivation }
  }
  reference_data_registry {
    testRequests
  }
  validate_measurement {
    "every([within_mpe]) = true"
  }
  ref derives-from "PD-05 §4.1"
}
