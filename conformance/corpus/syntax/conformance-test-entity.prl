# Conformance corpus: the conformance test entity. The retired
# validate_measurement verdict declares the canonical check
# (test-adjacent; TODO.lang-gaps/03).
# Clauses: SYN-04 (positive), SER-01 (positive).
provision ProvMPE {
  condition "The error shall not exceed the maximum permissible error"
  modality SHALL
}

conformance_test ErrorTest {
  name "Error determination"
  type Testing
  reference { R60doc#2.10.1 }
  targets {
    ProvMPE
  }
  procedure {
    step apply_the_test_load "Apply the test load"
    step record_the_indication "Record the indication"
  }
}
check conformance_test:ErrorTest:validate_measurement:1 {
  expression "[error] <= [mpe]"
  ref derives-from "conformance_test:ErrorTest"
}
