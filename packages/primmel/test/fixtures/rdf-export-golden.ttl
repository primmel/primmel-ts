# RDF/OWL export of the Primmel package "test-pkg" (Test package).
# Generated by `primmel export rdf` (primmel-ts, TODO.roadmap/27).
#
# ONE-WAY PROJECTION. The Primmel package remains the single source of
# truth; this graph is a lossy projection for linked-data consumers.
# Re-imports are new-model suggestions, NEVER merges.
#
# Vocabulary: the IEC-ISO Core Ontology for (SMART) standards content
# (smartSDU information-model share, ontologies/core-ontology.ttl,
# version 2.0.0) and its taxonomies; instance IRIs under urn:test:pkg:1.
#
# SURVIVES the projection:
#   - document + clause tree: the package as smart:PublicationDocument,
#     requirement classes as smart:Clause nested by /req/... id paths
#   - provisions: one node per requirement, typed by modality (shall ->
#     smart:Requirement, should -> smart:Recommendation, may ->
#     smart:Permission — the vocabulary's own modality form), and one
#     primmel:ConformanceTest per conformance test under a synthetic
#     "Conformance tests" clause; the modality token rides as
#     primmel:obligation data on every provision
#   - bindingness (normative) and provision type (governing) facets
#   - terms: smart:TermEntry + skosxl pref/alt/deprecated labels with
#     definitions, form/part-of-speech types when authored
#   - provenance: dcterms:source annotation IRIs (<doc#clause-X>)
#   - cross-references: dcterms:requires (dependencies),
#     primmel:verifies (conformance-test targets), dcterms:references
#     (bindings and term see-also naming exported ids)
#   - guidance as smart:ProvisionSupplement notes; the verification
#     method as inert primmel:verificationMethod data
#
# LOST in the projection (absent from this graph, by design):
#   - machine-checkable bindings (binds_to subject paths)
#   - OCL limit expressions and acceptance criteria
#   - quantities with units, typed parameters, applicability filters
#   - processes, forms, workflows, state machines, tables, formulas,
#     symbols (term symbol links)
#   - the publication layout: the share's oa:Annotation ->
#     dcat:Distribution content-fragment machinery is not projected —
#     statements and labels ride on the nodes (rdf:value, skosxl)
#   - conformance-test reference fragment detail (only doc+clause of a
#     test's reference survives)
#
# Extensions (prefix primmel:, urn:primmel:vocab:): primmel:ConformanceTest
# (the core vocabulary has no verification-provision class), primmel:verifies,
# primmel:obligation, primmel:verificationMethod, primmel:vocabRef,
# primmel:vocabTerm. smart:hasSectionNumber is reused undeclared-in-2.0.0,
# on the share's own precedent (its SHACL shapes + sample use it).
#
# Contents: 1 document, 2 requirement classes, 4 requirements, 1 conformance test, 3 terms, 2 supplements, 5 cross-references, 130 triples, 1 dropped reference.
@prefix inst: <urn:test:pkg:1#> .
@prefix smart: <https://w3id.org/standards/smart/ontologies/core/> .
@prefix bindingness-type: <https://w3id.org/standards/smart/taxonomies/bindingness-type/> .
@prefix provision-type: <https://w3id.org/standards/smart/taxonomies/provision-type/> .
@prefix provision-supplement-type: <https://w3id.org/standards/smart/taxonomies/provision-supplement-type/> .
@prefix publication-type: <https://w3id.org/standards/smart/taxonomies/publication-type/> .
@prefix term-form-type: <https://w3id.org/standards/smart/taxonomies/term-form-type/> .
@prefix part-of-speech-type: <https://w3id.org/standards/smart/taxonomies/part-of-speech-type/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix skosxl: <http://www.w3.org/2008/05/skos-xl#> .
@prefix primmel: <urn:primmel:vocab:> .

smart:Requirement rdfs:subClassOf smart:Provision .

smart:Recommendation rdfs:subClassOf smart:Provision .

smart:Permission rdfs:subClassOf smart:Provision .

smart:Clause rdfs:subClassOf smart:ProvisionSet .

primmel:ConformanceTest rdfs:subClassOf smart:Provision ;
    rdfs:label "conformance test — Primmel extension: the IEC-ISO Core Ontology has no verification-provision class (rdf-vocabulary.ts)" .

primmel:verifies rdfs:subPropertyOf dcterms:references ;
    rdfs:label "conformance test → verified requirement (Primmel extension)" .

primmel:obligation rdfs:label "modality token (shall | should | may | undefined) carried as data — the vocabulary’s own modality form is the rdf:type Provision subclass" .

primmel:verificationMethod rdfs:label "verification method facet as inert data (Primmel extension)" .

primmel:vocabRef rdfs:label "glossarist vocabulary-register citation \"<register>#<clause>\" (Primmel extension)" .

primmel:vocabTerm rdfs:label "register-preferred designation when it differs from the term (Primmel extension)" .

<urn:test:pkg:1> a smart:PublicationDocument ;
    dcterms:title "Test package"@en ;
    dcterms:identifier "test-pkg" ;
    smart:hasPublicationType publication-type:standard ;
    dcterms:description "A tiny RDF export fixture."@en ;
    dcterms:hasVersion "1" .

inst:req-scope a smart:Clause ;
    dcterms:identifier "/req/scope" ;
    dcterms:title "Scope requirements"@en ;
    dcterms:isPartOf <urn:test:pkg:1> ;
    dcterms:requires inst:req-other .

inst:req-other a smart:Clause ;
    dcterms:identifier "/req/other" ;
    dcterms:title "Other requirements"@en ;
    dcterms:isPartOf <urn:test:pkg:1> .

inst:req-scope-alpha a smart:Requirement ;
    dcterms:identifier "/req/scope/alpha" ;
    dcterms:title "Alpha"@en ;
    rdf:value "The widget shall frobnicate & pass <all> \"checks\"."@en ;
    primmel:obligation "shall" ;
    smart:hasBindingnessType bindingness-type:normative ;
    smart:hasProvisionType provision-type:governingProvision ;
    dcterms:isPartOf inst:req-scope ;
    primmel:verificationMethod "examination" ;
    dcterms:source <urn:test:r:1:2021#clause-5.2>,
        <urn:test:r:1:2021#clause-5.2.1> ;
    smart:hasSupplement inst:req-scope-alpha-note ;
    dcterms:requires inst:req-scope-beta ;
    dcterms:references inst:req-scope-beta .

inst:req-scope-alpha-note a smart:ProvisionSupplement ;
    smart:hasSupplementType provision-supplement-type:note ;
    rdf:value "Frobnicate gently."@en .

inst:req-scope-beta a smart:Recommendation ;
    dcterms:identifier "/req/scope/beta" ;
    dcterms:title "Beta"@en ;
    rdf:value "The widget should glow."@en ;
    primmel:obligation "should" ;
    smart:hasBindingnessType bindingness-type:normative ;
    smart:hasProvisionType provision-type:governingProvision ;
    dcterms:isPartOf inst:req-scope ;
    dcterms:source <urn:test:r:1:2021#clause-5.3> .

inst:req-scope-gamma a smart:Permission ;
    dcterms:identifier "/req/scope/gamma" ;
    dcterms:title "Gamma"@en ;
    rdf:value "The widget may hum."@en ;
    primmel:obligation "may" ;
    smart:hasBindingnessType bindingness-type:normative ;
    smart:hasProvisionType provision-type:governingProvision ;
    dcterms:isPartOf inst:req-scope .

inst:req-orphan a smart:Requirement ;
    dcterms:identifier "/req/orphan" ;
    dcterms:title "Orphan"@en ;
    rdf:value "The widget shall stand alone."@en ;
    primmel:obligation "shall" ;
    smart:hasBindingnessType bindingness-type:normative ;
    smart:hasProvisionType provision-type:governingProvision ;
    dcterms:isPartOf <urn:test:pkg:1> .

inst:conformance-tests a smart:Clause ;
    dcterms:identifier "primmel:conformance-tests" ;
    dcterms:title "Conformance tests"@en ;
    dcterms:isPartOf <urn:test:pkg:1> .

inst:conf-scope-tests-alpha-check a primmel:ConformanceTest ;
    dcterms:identifier "/conf/scope-tests/alpha-check" ;
    dcterms:title "Alpha check"@en ;
    rdf:value "Verify the widget frobnicates."@en ;
    primmel:obligation "undefined" ;
    smart:hasBindingnessType bindingness-type:normative ;
    dcterms:isPartOf inst:conformance-tests ;
    dcterms:source <urn:test:r:2:2021#clause-A.3> ;
    smart:hasSupplement inst:conf-scope-tests-alpha-check-note ;
    primmel:verifies inst:req-scope-alpha .

inst:conf-scope-tests-alpha-check-note a smart:ProvisionSupplement ;
    smart:hasSupplementType provision-supplement-type:note ;
    rdf:value "Check twice."@en .

inst:term-widget a smart:TermEntry ;
    dcterms:identifier "widget" ;
    dcterms:isPartOf <urn:test:pkg:1> ;
    skos:definition "a thing that frobnicates"@en ;
    smart:hasSectionNumber "3.1" ;
    dcterms:source <urn:test:r:1:2021#clause-3.1> ;
    skosxl:prefLabel inst:term-widget-label ;
    skosxl:altLabel inst:term-widget-alt-1 .

inst:term-widget-label a smart:Term,
        skosxl:Label ;
    skosxl:literalForm "widget"@en ;
    smart:hasTermFormType term-form-type:fullForm ;
    smart:hasPartOfSpeechType part-of-speech-type:noun .

inst:term-widget-alt-1 a smart:Term,
        skosxl:Label ;
    skosxl:literalForm "wdg"@en ;
    smart:hasTermFormType term-form-type:abbreviation .

inst:term-frobnication a smart:TermEntry ;
    dcterms:identifier "frobnication" ;
    dcterms:isPartOf <urn:test:pkg:1> ;
    skos:definition "the act of frobnicating"@en ;
    skos:scopeNote "Applies to widgets only."@en ;
    skos:note "Frobnication is reversible."@en ;
    smart:hasSectionNumber "3.2" ;
    primmel:vocabRef "viml-2022#5.15" ;
    primmel:vocabTerm "frobnication act"@en ;
    skosxl:prefLabel inst:term-frobnication-label ;
    smart:deprecatedLabel inst:term-frobnication-deprecated-1 ;
    dcterms:references inst:term-widget .

inst:term-frobnication-label a smart:Term,
        skosxl:Label ;
    skosxl:literalForm "frobnication"@en .

inst:term-frobnication-deprecated-1 a smart:Term,
        skosxl:Label ;
    skosxl:literalForm "frobnicating"@en .

inst:term-gloom a smart:TermEntry ;
    dcterms:identifier "gloom" ;
    dcterms:isPartOf <urn:test:pkg:1> ;
    skos:definition "the state of a widget that does not glow"@en ;
    smart:hasSectionNumber "4.1" ;
    skosxl:prefLabel inst:term-gloom-label .

inst:term-gloom-label a smart:Term,
        skosxl:Label ;
    skosxl:literalForm "gloom"@en .
